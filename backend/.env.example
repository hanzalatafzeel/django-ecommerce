# ==========================================================================
# High-Volume E-commerce Platform — environment template
# Copy to `.env` and adjust. Defaults run the full stack in dev on SQLite +
# embedded Redis (redislite) — no external services required.
# ==========================================================================

# --- Django core ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# --- Database: sqlite (dev) | postgres (production / docker-compose) ---
# Options: sqlite | postgres
DB_ENGINE=sqlite
POSTGRES_DB=ecom
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis: caching + WebSocket channel layer ---
# Dev: run `python manage.py start_redis` to boot embedded Redis (no root).
# Prod: point REDIS_URL at your redis instance (docker-compose exposes 6379).
CACHE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0

# --- CORS (React dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional: real Stripe gateway (leave empty to use the simulated gateway) ---
# STRIPE_SECRET_KEY=

# --- Shop simulation knobs ---
SHOP_SIMULATED_DELIVERY_DAYS=4